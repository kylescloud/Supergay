# Base Network Configuration
BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=your_basescan_api_key

# Private RPC Nodes (for execution only - highly recommended)
# Configure 2 private RPC nodes for reliable transaction execution
PRIVATE_RPC_1=https://your-private-rpc-1.com
PRIVATE_RPC_2=https://your-private-rpc-2.com

# Private Key (DO NOT commit this file)
PRIVATE_KEY=your_private_key_here

# Aave V3 Pool Address on Base
AAVE_V3_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# Flash Loan Receiver Contract
FLASH_LOAN_RECEIVER=0x...

# Bot Configuration
MIN_PROFIT_THRESHOLD=0.01  # Minimum profit in USD
MAX_GAS_PRICE=20000000000  # 20 gwei
FLASH_LOAN_PREMIUM=0.0009  # 0.09% premium
SLIPPAGE_TOLERANCE=0.003   # 0.3% slippage

# MEV Protection
USE_FLASHBOTS=true
FLASHBOTS_RPC=https://rpc.flashbots.net

# Monitoring
ENABLE_ALERTS=true
WEBHOOK_URL=your_webhook_url

# Telegram Bot Configuration (Optional - for alerts)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id